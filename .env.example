# ─────────────────────────────────────────────────────────────
# 데이트 코스 추천 앱 환경설정 예시
# 이 파일을 복사해 ".env" 로 만들고 값을 채우세요. (.env 는 git에 올리지 마세요)
# 키가 없어도 앱은 시드 데이터로 정상 동작합니다. 키는 "실데이터 수집"과 "LLM 코스 설명"에만 필요합니다.
# ─────────────────────────────────────────────────────────────

# 서버 포트
PORT=3000

# ── 비밀번호 보호(선택) ──
# APP_PASSWORD 를 채우면 접속 시 로그인(아이디/비번)을 요구합니다. 나만 쓰려면 권장.
# 비워두면 인증 없이 누구나 접속 가능합니다(로컬 개발 편의).
APP_USERNAME=
APP_PASSWORD=

# ── 네이버 지역검색 API (장소 수집용) ──
# https://developers.naver.com/apps  → 애플리케이션 등록 → "검색" API 추가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 카카오 로컬 API (좌표/거리/장소 수집용) ──
# https://developers.kakao.com  → 내 애플리케이션 → REST API 키
KAKAO_REST_API_KEY=

# ── 프론트엔드 카카오 지도 표시용 JavaScript 키 (선택) ──
# 지도 위에 코스를 그리려면 필요. 없으면 지도 없이 목록만 표시됩니다.
KAKAO_JS_KEY=

# ── LLM API (코스 설명/추천 멘트 생성용, 선택) ──
# 없으면 규칙 기반 템플릿 문구로 자동 대체됩니다.
# OpenAI 호환 엔드포인트 기준
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
