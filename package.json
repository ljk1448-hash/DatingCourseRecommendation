{
  "name": "date-course-recommender",
  "version": "0.1.0",
  "description": "지역과 원하는 특성을 고르면 조건에 맞는 데이트 코스를 추천하는 개인용 모바일 웹앱(PWA)",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
